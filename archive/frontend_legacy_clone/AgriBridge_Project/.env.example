# AgriBridge Production / Hackathon Environment Configuration
# (Example values only - DO NOT commit real API secrets)

# Host Configuration
PORT=3000
HOST=0.0.0.0

# Optional FastAPI Gateway
FASTAPI_API_URL=http://127.0.0.1:8000

# Weather API (OpenWeatherMap / IMD)
WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY_HERE
WEATHER_API_BASE_URL=https://api.openweathermap.org/data/2.5

# IoT Gateway / MQTT Broker (Hardware Ready)
MQTT_BROKER_HOST=broker.emqx.io
MQTT_BROKER_PORT=1883
MQTT_TOPIC_TELEMETRY=agribridge/farm/zone_a/telemetry

# Notification Gateway (Twilio / Telegram / n8n)
NOTIFICATION_PROVIDER=in_app
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
N8N_WEBHOOK_URL=http://localhost:5678/webhook/agribridge-alert

# Security & Master Admin Passcode
ADMIN_MASTER_PASSCODE=admin123
SESSION_SECRET_KEY=agribridge_super_secure_jwt_secret_2026

